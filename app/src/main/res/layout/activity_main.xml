<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_hyperos_fix"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvDeviceModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_device"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/fcm_heartbeat_title"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchFcmHeartbeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_service"
            android:textColor="@color/text_secondary" />
        <TextView
            android:id="@+id/tvHeartbeatStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/service_stopped"
            android:textColor="@color/status_bad"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/tvPingStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/surface_card_secondary"
            android:padding="6dp"
            android:text="Socket: mtalk.google.com:5228"
            android:textColor="#81C784"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/tvShizukuStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/shizuku_status_inactive"
            android:textColor="@color/status_warning"
            android:textSize="12sp" />
        <Button
            android:id="@+id/btnAppList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/btn_manage_apps" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_miui_settings"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnAutostart"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/btn_autostart" />
        <Button
            android:id="@+id/btnBatterySaver"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/btn_battery_saver" />
        <Button
            android:id="@+id/btnBatteryOpt"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/btn_battery_optimization" />
        <Button
            android:id="@+id/btnNotificationListener"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/btn_notification_listener" />
    </LinearLayout>
</ScrollView>
